# 可选 stdio 工具镜像：在极简网关镜像上叠加 Node.js（官方发行版思路由卷安装更推荐）。
# 适用：希望开箱即用 npx/node，且可接受镜像体积增大的部署。
# 构建：先按 CI 产出 bin/mpg-linux-$ARCH，再：
#   docker build -f Dockerfile.stdio --build-arg TARGETARCH=amd64 -t xylplm/mcp-proxy-gateway:stdio .
#
# 注意：生产更推荐默认 Dockerfile + 数据卷 /data/runtime 预置安装（管理台一键或手动放入）。

ARG BASE_IMAGE=xylplm/mcp-proxy-gateway:latest
FROM ${BASE_IMAGE}

USER root
RUN apk add --no-cache nodejs npm \
  && node -v \
  && npm -v

# 保持与默认镜像相同的 entrypoint / 数据卷约定
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/mpg"]
